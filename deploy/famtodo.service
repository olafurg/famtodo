[Unit]
Description=Fam Todo
After=network.target

[Service]
User=famtodo
WorkingDirectory=/opt/famtodo
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=PUBLIC_URL=https://todo.olafurg.com
Environment=VAPID_SUBJECT=mailto:olafur.g@gmail.com
ExecStart=/usr/bin/node server.js
Restart=always

[Install]
WantedBy=multi-user.target
